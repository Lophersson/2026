
<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DIRETO — 2 Agosto 2026</title>
<link rel="preconnect" href="https://googleapis.com">
<link href="https://googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=DM+Sans:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --void:#ffffff;
    --panel:#ffffff;
    --gold:#000000;
    --gold-dim:#333333;
    --ink:#000000;
    --ink-dim:#555555;
    --red:#c62b32;
    --line:#000000;
    --card-bg:#ffffff;
    --card-ink:#000000;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;height:100%;}
  body{
    background:#ffffff;
    color:var(--ink);
    font-family:'DM Sans', sans-serif;
    height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:14px 16px;
    overflow:hidden;
  }

  .stage{
    width:100%;
    max-width:99vw;
    height:100%;
    max-height:98vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
  }

  /* ---- HEADER ---- */
  header{
    width:100%;
    position:relative;
    display:flex;
    flex-direction:column;
    align-items:center;
    flex:0 0 auto;
    margin-bottom:clamp(6px, 1.8vh, 16px);
  }
  .clock{
    position:absolute;
    top:0;
    right:0;
    text-align:right;
    font-family:'DM Mono', monospace;
    font-size:11px;
    letter-spacing:0.06em;
    color:var(--ink-dim);
    line-height:1.5;
    text-transform:uppercase;
  }
  .clock .time{
    color:var(--ink);
    font-size:13px;
    font-weight:700;
  }
  .title-row{
    display:flex;
    align-items:center;
    gap:12px;
  }
  .live-dot{
    width:11px;
    height:11px;
    border-radius:50%;
    background:var(--red);
    box-shadow:0 0 10px 2px rgba(198,43,50,0.5);
    animation:dotpulse 1.4s ease-in-out infinite;
    flex-shrink:0;
  }
  @keyframes dotpulse{
    0%,100%{opacity:1; transform:scale(1);}
    50%{opacity:0.35; transform:scale(0.8);}
  }
  h1.directo{
    font-family:'Cormorant Garamond', serif;
    font-weight:700;
    font-size:clamp(30px, 4.6vh, 54px);
    letter-spacing:0.14em;
    margin:0;
    color:var(--ink);
    animation:blink 1.6s ease-in-out infinite;
  }
  @keyframes blink{
    0%,45%,100%{opacity:1;}
    50%,90%{opacity:0.22;}
  }
  .subline{
    font-family:'DM Mono', monospace;
    font-size:20px;
    letter-spacing:0.28em;
    text-transform:uppercase;
    color:var(--ink-dim);
    margin-top:2px;
  }

  /* ---- FICHA ---- */
  main{
    width:100%;
    flex:1 1 auto;
    min-height:0;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
  }

  .ficha-wrap{
    width:100%;
    max-width:none;
    flex:1 1 auto;
    min-height:0;
    display:flex;
    align-items:stretch;
  }

  table.ficha{
    width:100%;
    border-collapse:collapse;
    border:5px solid var(--line);
    table-layout:fixed;
    background:var(--card-bg);
    color:var(--card-ink);
  }
  table.ficha td{
    border:5px solid var(--line);
    padding:0;
  }
  .num-cell{
    width:28%;
    text-align:center;
    vertical-align:middle;
    padding:5px;
  }
  .num-cell .num{
    font-family:'DM Mono', monospace;
    font-weight:700;
    font-size:clamp(300px, 15vh, 150px);
    line-height:1;
    color: black;
    letter-spacing:-0.02em;
  }
  .name-cell{
    text-align:center;
    vertical-align:middle;
    padding:clamp(10px, 2vh, 22px) 30px;
  }
  .name-cell .art-name{
    font-family:'Cormorant Garamond', serif;
    font-weight:700;
    font-size:clamp(50px, 5.6vh, 50px);
    line-height:1.0;
    outline:none;
    display:block;
    color: black;
    font-style:normal;
  }
  .price-cell{
    text-align:center;
    vertical-align:middle;
    padding:clamp(8px, 1.6vh, 16px) 20px;
    font-family:'DM Mono', monospace;
  }
  .price-cell .row{
    display:flex;
    justify-content:space-between;
    font-size:clamp(30px, 5.6vh, 30px);
    padding:clamp(2px, 0.6vh, 6px) 6px;
    color:#000000;
  }
  .price-cell .row span:last-child{
    outline:none;
    min-width:70px;
    text-align:right;
  }
  .price-cell .row.total{
    margin-top:clamp(4px, 0.8vh, 8px);
    padding-top:clamp(6px, 1vh, 10px);
    border-top:2px solid var(--card-ink);
    font-weight:700;
    font-size:clamp(30px, 5.6vh, 30px);
    color:var(--card-ink);
  }

  /* ---- DETAILS CELL: cor, unidades, tallas ---- */
  .details-cell{
    padding:clamp(8px, 1.6vh, 16px) 20px;
    font-family:'DM Mono', monospace;
    vertical-align:middle;
  }
  .details-grid{
    display:flex;
    gap:18px;
    align-items:stretch;
  }
  .details-block{
    flex:1 1 0;
    text-align:center;
  }
  .details-block + .details-block{
    border-left:2px solid var(--card-ink);
    padding-left:18px;
  }
  .details-label{
    font-size:clamp(24px, 5.6vh, 24px);
    letter-spacing:0.0em;
    color:var(--ink-dim);
    margin-bottom:4px;
  }
  .details-value{
    font-size:clamp(20px, 5.6vh, 20px);
    font-weight:700;
    color:var(--card-ink);
  }
  .sizes-list{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:6px 12px;
    font-size:clamp(20px, 5.6vh, 20px);
    color:black;
  }
  .sizes-list .size-chip b{
    color: red;
  }
  .sizes-list .size-chip b::after {
  content: ";";
}
  .sizes-empty{
    font-size:clamp(20px, 5.6vh, 20px);
    color:var(--ink-dim);
  }

  [contenteditable="true"]:focus{
    background:rgba(0,0,0,0.06);
  }

  .controls{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    justify-content:center;
    gap:22px;
    flex:0 0 auto;
    margin-top:clamp(20px, 2vh, 50px);
  }

  .nav { display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important; align-items: center !important; justify-content: center !important; gap: 22px !important; flex: 0 0 auto !important; height: 50px !important; min-height: 50px !important; margin-top: clamp(8px, 1.6vh, 16px) !important; width: 100% !important; }
  .nav > div, .nav > ul { display: contents !important; }
  .arrow-btn { width: 150px !important; height: 50px !important; flex-shrink: 0 !important; border-radius: 0%; border: 2px solid #000000; background: transparent; color: #000000; font-size: 17px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.18s, transform 0.12s; }
  .arrow-btn:hover { background: rgba(0,0,0,0.08); }
  .arrow-btn:active { transform: scale(0.92); }
  .arrow-btn:disabled { opacity: 0.25; cursor: default; }
  .arrow-btn:disabled:hover { background: transparent; }
  .position { font-family: 'DM Mono', monospace; font-size: 24px; letter-spacing: 0.1em; color: var(--ink-dim); min-width: 70px; text-align: center; flex-shrink: 0 !important; }
  .position b { color: #000000; }
  .jump { display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important; align-items: center !important; gap: 8px !important; font-family: 'DM Mono', monospace; font-size: 24px; color: var(--ink-dim); margin-top: 0 !important; flex-shrink: 0 !important; }
  .jump input { width: 80px; height: 40px !important; background: #ffffff; border: 1px solid #000000; color: #000000; font-family: 'DM Mono', monospace; font-size: 24px; padding: 4px 8px; text-align: center; border-radius: 2px; }
  .jump button { background: transparent; border: 1px solid #000000; color: #000000; font-family: 'DM Sans', sans-serif; font-size: 11px; padding: 4px 10px; border-radius: 2px; cursor: pointer; height: 28px !important; display: flex !important; align-items: center; }
  .jump button:hover { background: rgba(0,0,0,0.06); }

  @media (max-width: 480px){
    body{ padding:8px 10px; }
    .clock{ font-size:9px; }
    .clock .time{ font-size:11px; }
    h1.directo{ font-size:clamp(20px, 6vw, 30px); }
    .subline{ font-size:12px; letter-spacing:0.2em; }
    table.ficha{ border-width:3px; }
    table.ficha td{ border-width:3px; }
    .num-cell .num{ font-size:clamp(70px, 22vw, 110px); }
    .name-cell{ padding:10px 10px; }
    .name-cell .art-name{ font-size:clamp(22px, 6.5vw, 30px); }
    .price-cell{ padding:8px 10px; }
    .price-cell .row{ font-size:clamp(14px, 4vw, 17px); padding:3px 4px; }
    .price-cell .row.total{ font-size:clamp(16px, 4.6vw, 20px); }
    .details-cell{ padding:8px 10px; }
    .details-grid{ flex-direction:column; gap:8px; }
    .details-block + .details-block{ border-left:none; border-top:1px solid var(--card-ink); padding-left:0; padding-top:8px; }
    .arrow-btn{ width:36px; height:36px; font-size:15px; }
    .position{ font-size:11px; min-width:60px; }
    .jump{ font-size:10px; }
  }
</style>
</head>
<body>

<div class="stage">
  <header>
    <div class="clock">
      <div class="date" id="dateOut">—</div>
      <div class="time" id="timeOut">—</div>
    </div>
    <div class="title-row">
      <span class="live-dot"></span>
      <h1 class="directo">DIRETO</h1>
    </div>
    <div class="subline">Emissão em curso</div>
  </header>

  <main>
    <div class="ficha-wrap">
      <table class="ficha">
        <tr>
          <td class="num-cell" rowspan="3"><span class="num" id="numOut">82</span></td>
          <td class="name-cell"><span class="art-name" contenteditable="true" id="nameOut">Nome do artigo</span></td>
        </tr>
        <tr>
          <td class="price-cell">
            <div class="row"><span>Preço</span><span contenteditable="true" id="priceOut">0,00 €</span></div>
            <div class="row"><span>Comissão</span><span contenteditable="true" id="commOut">0,00 €</span></div>
            <div class="row total"><span>Total a pagar</span><span id="totalOut">0,00 €</span></div>
          </td>
        </tr>
        <tr>
          <td class="details-cell">
            <div class="details-grid">
              <div class="details-block">
                <div class="details-label">Cor</div>
                <div class="details-value" id="colorOut">—</div>
              </div>
              <div class="details-block">
                <div class="details-label">units</div>
                <div class="details-value" id="unitsOut">1</div>
              </div>
              <div class="details-block" style="flex:2 1 0;">
                <div class="details-label">Tallas</div>
                <div class="sizes-list" id="sizesOut"></div>
              </div>
            </div>
          </td>
        </tr>
      </table>
    </div>

 <div class="controls">
    <div class="nav">
      <button class="arrow-btn" id="prevBtn" aria-label="Ficha anterior">←</button>
      <div class="position"><b id="posOut">1</b> / <span id="countOut">33</span></div>
      <button class="arrow-btn" id="nextBtn" aria-label="Ficha seguinte">→</button>
    </div>

    <div class="jump">
      <span>Ir ao nº</span>
      <input type="number" id="jumpInput" min="82" max="114" value="82">
      <button id="jumpBtn">Ir</button>
    </div>
    </div>
  </main>
</div>

<script>
  // ---- Relógio em direto ----
  const dateOut = document.getElementById('dateOut');
  const timeOut = document.getElementById('timeOut');
  function tickClock(){
    const now = new Date();
    dateOut.textContent = now.toLocaleDateString('pt-PT', { day:'2-digit', month:'2-digit', year:'numeric' });
    timeOut.textContent = now.toLocaleTimeString('pt-PT', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
  }
  tickClock();
  setInterval(tickClock, 1000);

  // ---- Dados das fichas (82 → 114) ----
  const datos = {
    30: { name:'calças pretas e amarelas space jam', price:0.00, comm:0.00, color:'preto e amarelo', sizes:[{s:'7/8',q:1}] },
    31: { name:'calças de ganga cinzentas', price:0.00, comm:0.00, color:'cinzento', sizes:[{s:'7',q:1}] },
    32: { name:'calças fato treino pretas unlimited', price:0.00, comm:0.00, color:'preto', sizes:[{s:'146',q:1}] },
    33: { name:'conjunto fato treino cinzento/preto Spiderman calças e casaco Marvel', price:0.00, comm:0.00, color:'cinzento e preto', sizes:[{s:'10',q:1}] },
    34: { name:'calças ganga cinzento/pretas corda c&a', price:0.00, comm:0.00, color:'cinzento e preto', sizes:[{s:'9',q:1}] },
    35: { name:'camisa azul santa Claus, Rudolf e árvores natal h&m', price:0.00, comm:0.00, color:'azul', sizes:[{s:'8/9',q:1}] },
    36: { name:'camisola preta manga comprida be in the game lefties', price:0.00, comm:0.00, color:'preta', sizes:[{s:'9/10',q:1}] },
    37: { name:'sueter cinzento headphones', price:0.00, comm:0.00, color:'cinzento', sizes:[] },
    38: { name:'sueter malha cinzento cobra like my Flow', price:0.00, comm:0.00, color:'cinzento', sizes:[] },
    39: { name:'calças pretas minecraft', price:0.00, comm:0.00, color:'preta', sizes:[{s:'9/10',q:1}] },
    40: { name:'conjunto jurassic park', price:0.00, comm:0.00, color:'—', sizes:[{s:'10/11',q:1}] },
    41: { name:'sueter cinzento run faster', price:0.00, comm:0.00, color:'cinzento', sizes:[{s:'134/140',q:1}] },
    42: { name:'calças pretas fato treino monstro zipper', price:0.00, comm:0.00, color:'preta', sizes:[{s:'146',q:1}] },
    43: { name:'calças riscas azuis e cinzentas polar', price:0.00, comm:0.00, color:'azul e cinzento', sizes:[{s:'9/10',q:1}] },
    44: { name:'camisa preta unstopable atitude', price:0.00, comm:0.00, color:'preta', sizes:[{s:'5/6',q:1}] },
    45: { name:'sueter cinzento e azul gorila oculos neve', price:0.00, comm:0.00, color:'cinzento e azul', sizes:[{s:'7/8',q:1}] },
    46: { name:'sueter Sonic azul escuro capuz', price:0.00, comm:0.00, color:'azul escuro', sizes:[{s:'11/12',q:1}] },
    47: { name:'sueter malha united colors of Benetton', price:0.00, comm:0.00, color:'—', sizes:[{s:'4/5',q:1}] },
    48: { name:'sueter azul capuz cuadrados escocés new york city', price:0.00, comm:0.00, color:'azul', sizes:[{s:'10',q:1}] },
    49: { name:'sueter cinzento cara amarela smiley', price:0.00, comm:0.00, color:'cinzento e amarelo', sizes:[{s:'10/12',q:1}] },
    50: { name:'sueter malha azul celeste barco branco', price:0.00, comm:0.00, color:'azul celeste e branco', sizes:[{s:'18',q:1}] },
    51: { name:'sueter malha azul escuro', price:0.00, comm:0.00, color:'azul escuro', sizes:[{s:'3',q:1}] },
    52: { name:'sueter preta gola alta', price:0.00, comm:0.00, color:'preta', sizes:[{s:'4',q:1}] },
    53: { name:'sueter capuz branco e laranxa animal', price:0.00, comm:0.00, color:'branco e laranxa', sizes:[{s:'3',q:1}] },
    54: { name:'camisola riscas azuis e brancas friendas 4 ever', price:0.00, comm:0.00, color:'azul e branco', sizes:[{s:'122',q:1}] },
    55: { name:'calças ganga verde kiabi', price:0.00, comm:0.00, color:'verde', sizes:[{s:'9',q:1}] },
    56: { name:'calças azul escuro c&a', price:0.00, comm:0.00, color:'azul escuro', sizes:[{s:'10',q:1}] },
    57: { name:'calças castanhas', price:0.00, comm:0.00, color:'castanho', sizes:[{s:'8',q:1}] },
    58: { name:'sueter capuz branca e azul Hogwarts', price:0.00, comm:0.00, color:'branco e azul', sizes:[{s:'8/10',q:1}] },
    60: { name:'sueter azul super Mario', price:0.00, comm:0.00, color:'azul', sizes:[{s:'10',q:1}] },
    61: { name:'kit escolar k-pop demon hunters', price:0.00, comm:0.00, color:'roxo', sizes:[] },
    62: { name:'estojo roxo escolar zipper', price:0.00, comm:0.00, color:'roxo', sizes:[] },
    63: { name:'caderno de notas roxo copo e alimentos', price:0.00, comm:0.00, color:'roxo', sizes:[] },
  };

  // ---- Constrói a lista de fichas a partir de "datos" ----
  const fichas = Object.keys(datos)
    .map(Number)
    .sort((a, b) => a - b)
    .map(num => {
      const d = datos[num];
      const sizes = d.sizes || [];
      const units = (typeof d.units === 'number')
        ? d.units
        : (sizes.length ? sizes.reduce((sum, sz) => sum + sz.q, 0) : 1);
      return {
        num,
        name: d.name,
        price: d.price,
        comm: d.comm,
        color: d.color || '—',
        sizes,
        units
      };
    });

  let idx = 0;

  const numOut = document.getElementById('numOut');
  const nameOut = document.getElementById('nameOut');
  const priceOut = document.getElementById('priceOut');
  const commOut = document.getElementById('commOut');
  const totalOut = document.getElementById('totalOut');
  const colorOut = document.getElementById('colorOut');
  const unitsOut = document.getElementById('unitsOut');
  const sizesOut = document.getElementById('sizesOut');
  const posOut = document.getElementById('posOut');
  const countOut = document.getElementById('countOut');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const jumpInput = document.getElementById('jumpInput');
  const jumpBtn = document.getElementById('jumpBtn');

  countOut.textContent = fichas.length;

  function parseMoney(str){
    const clean = str.replace(/[^\d,.-]/g,'').replace(',', '.');
    const val = parseFloat(clean);
    return isNaN(val) ? 0 : val;
  }
  function fmtMoney(val){
    return val.toLocaleString('pt-PT', { minimumFractionDigits:2, maximumFractionDigits:2 }) + ' €';
  }

  function saveCurrentEdits(){
    const f = fichas[idx];
    const html = nameOut.innerHTML.trim();
    f.name = html || 'Nome do artigo';
    f.price = parseMoney(priceOut.textContent);
    f.comm = parseMoney(commOut.textContent);
  }

  function renderSizes(sizes){
    sizesOut.innerHTML = '';
    if(!sizes || sizes.length === 0){
      const span = document.createElement('span');
      span.className = 'sizes-empty';
      span.textContent = 'Sem tallas (talla única)';
      sizesOut.appendChild(span);
      return;
    }
    sizes.forEach(sz => {
      const chip = document.createElement('span');
      chip.className = 'size-chip';
      chip.innerHTML = sz.s + '<b>x' + sz.q + '</b>';
      sizesOut.appendChild(chip);
    });
  }

  function render(){
    const f = fichas[idx];
    numOut.textContent = f.num;
    nameOut.innerHTML = f.name;
    priceOut.textContent = fmtMoney(f.price);
    commOut.textContent = fmtMoney(f.comm);
    totalOut.textContent = fmtMoney(f.price + f.comm);
    colorOut.textContent = f.color;
    unitsOut.textContent = f.units;
    renderSizes(f.sizes);
    posOut.textContent = idx + 1;
    jumpInput.value = f.num;
    prevBtn.disabled = idx === 0;
    nextBtn.disabled = idx === fichas.length - 1;
  }

  function goTo(newIdx){
    saveCurrentEdits();
    idx = Math.max(0, Math.min(fichas.length - 1, newIdx));
    render();
  }

  prevBtn.addEventListener('click', () => goTo(idx - 1));
  nextBtn.addEventListener('click', () => goTo(idx + 1));

  jumpBtn.addEventListener('click', () => {
    const target = parseInt(jumpInput.value, 10);
    if(!isNaN(target)){
      const found = fichas.findIndex(f => f.num === target);
      if(found !== -1) goTo(found);
    }
  });

  [priceOut, commOut].forEach(el => {
    el.addEventListener('input', () => {
      const p = parseMoney(priceOut.textContent);
      const c = parseMoney(commOut.textContent);
      totalOut.textContent = fmtMoney(p + c);
    });
  });

  nameOut.addEventListener('keydown', (e) => {
    if(e.key === 'Enter'){
      e.preventDefault();
      document.execCommand('insertLineBreak');
    }
  });

  document.addEventListener('keydown', (e) => {
    if(document.activeElement === nameOut || document.activeElement === priceOut || document.activeElement === commOut) return;
    if(e.key === 'ArrowLeft') goTo(idx - 1);
    if(e.key === 'ArrowRight') goTo(idx + 1);
  });

  let touchStartX = 0;
  let touchStartY = 0;
  const SWIPE_THRESHOLD = 40;

  document.addEventListener('touchstart', (e) => {
    if(document.activeElement === nameOut || document.activeElement === priceOut || document.activeElement === commOut) return;
    touchStartX = e.changedTouches[0].screenX;
    touchStartY = e.changedTouches[0].screenY;
  }, { passive:true });

  document.addEventListener('touchend', (e) => {
    if(document.activeElement === nameOut || document.activeElement === priceOut || document.activeElement === commOut) return;
    const touchEndX = e.changedTouches[0].screenX;
    const touchEndY = e.changedTouches[0].screenY;
    const diffX = touchEndX - touchStartX;
    const diffY = touchEndY - touchStartY;
    if(Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > SWIPE_THRESHOLD){
      if(diffX < 0){
        goTo(idx + 1);
      } else {
        goTo(idx - 1);
      }
    }
  }, { passive:true });

  render();
</script>
</body>
</html>
